# 雲端智學 — Caddy 設定
#
# TLS 由 TLS_MODE 決定，見 .env 第 2 節。
#
# **Caddy 的設定檔不支援條件式**，所以 TLS_MODE 不能寫成 if。
# 早期版本把三種模式各寫成一個 site block，指望「未使用的 block
# 因主機名不匹配而不生效」——那是錯的：`{$APP_DOMAIN} { … }` 會
# **無條件**觸發公開 ACME 簽發。TLS_MODE=internal 加一個內網主機名
# 的結果是 Caddy 反覆向 Let's Encrypt 申請失敗（DNS 不通、80 埠
# 不可達），該主機名的 HTTPS 握手一直失敗，而 `:443 { tls internal }`
# 因為主機名比對優先級較低而輪不到。開學第一天學生連不進來。
#
# 改法：把整個 tls 指示詞交給 TLS_MODE 展開。Caddy 的環境變數
# 替換發生在解析之前，所以 `tls {$TLS_DIRECTIVE}` 可以展開成
# `tls internal`、空字串（＝自動 ACME）、或憑證路徑。
# 展開的內容由 deploy/scripts/render-caddy.sh 依 TLS_MODE 產生。

{
	admin :2019
	email {$ACME_EMAIL}
	servers {
		# 學生作答時的長輪詢與 SSE 需要較長的寫入逾時
		timeouts {
			read_body 30s
			read_header 10s
			write 300s
			idle 600s
		}
	}
}

(common) {
	encode zstd gzip

	header {
		# 這幾條是防作弊架構（規格書文件 04）的瀏覽器層基礎，
		# 少了它們，全螢幕鎖定與焦點偵測可以被 iframe 繞過。
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# 健康檢查不要記進 access log，否則日誌會被每 15 秒一次的
	# 探測塞滿，真正的錯誤反而找不到。
	@health path /api/healthz /api/readyz
	log_skip @health

	# 上傳題本可能是幾十 MB 的掃描 PDF
	request_body {
		max_size 200MB
	}

	# 監控介面只在啟用 monitoring profile 時存在；
	# 沒啟用時 Caddy 會回 502，這是預期行為。
	handle_path /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy web:3000 {
			health_uri /api/readyz
			health_interval 15s
			health_timeout 5s
			# 一個 web 實例掛掉時把流量導到另一個，
			# 而不是讓正在考試的學生看到 502。
			lb_policy least_conn
			lb_try_duration 5s
			fail_duration 30s
		}
	}

	log {
		output stdout
		format json
		level INFO
	}
}

# ── 維護模式 ────────────────────────────────────────────────
#
# 升級時 upgrade.sh 會 touch 這個檔。沒有這一段的話，升級的
# 六到八分鐘裡學生看到的是 Caddy 原始的 502，而不是「你先前的
# 作答已經儲存」——那會引來一堆電話。
(maintenance) {
	@maint file /srv/maintenance/.maintenance
	handle @maint {
		root * /srv/maintenance
		rewrite * /index.html
		file_server
		header Retry-After "600"
	}
}

# ── 站台 ─────────────────────────────────────────────────────
#
# TLS_DIRECTIVE 由 render-caddy.sh 依 TLS_MODE 產生：
#   public   → 空字串（Caddy 自動向 Let's Encrypt 申請）
#   internal → internal（Caddy 自己的本地 CA）
#   custom   → /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
#
# internal 模式的根憑證用 deploy/scripts/export-ca.sh 匯出後由 MIS
# 派送到學生電腦，否則瀏覽器會出現憑證警告。那是「讓瀏覽器信任
# 本站」的憑證，不會也不能用來解密其他網站的流量——與規格書
# 文件 08 明確否決的「TLS 攔截」是完全不同的東西。
{$APP_DOMAIN} {
	tls {$TLS_DIRECTIVE}
	import maintenance
	import common
}

# 用 IP 直連時也要有得走（internal 模式常見）。
:443 {
	tls {$TLS_DIRECTIVE}
	import maintenance
	import common
}

# HTTP 一律轉 HTTPS
:80 {
	redir https://{host}{uri} permanent
}
