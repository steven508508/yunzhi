[Unit]
Description=雲端智學 — 背景工作者
Documentation=file:///opt/yunzhi/docs/OPERATIONS.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=yunzhi
Group=yunzhi
EnvironmentFile=/etc/default/yunzhi
EnvironmentFile=/etc/yunzhi/env
Environment=NODE_ENV=production
WorkingDirectory=/opt/yunzhi
ExecStart=/usr/bin/node scripts/worker.mjs

Restart=always
RestartSec=5
# 啟動失敗連續 5 次就停止重試。無限重啟會把日誌塞滿，
# 掩蓋掉最初那一次真正有用的錯誤訊息。
StartLimitBurst=5
StartLimitIntervalSec=120

# 優雅關閉。60 秒讓 worker 把手上的工作收尾。
#
# 這裡以前寫的是「讓學生把本地暫存同步上來」——那是錯的，前端沒有
# 本機暫存，而且 worker 根本不處理作答。
#
# 真正的理由是匯入：一份 200 頁的題本要跑一小時，被砍掉的工作會因為
# BullMQ 的鎖過期而 stalled 重派，從 fromStage 整段重跑——也就是
# 「同一份題本被解析兩次、付兩次錢」。60 秒讓它至少把目前的階段
# 結果寫下去。
KillSignal=SIGTERM
TimeoutStopSec=60

# ── 沙箱化 ──────────────────────────────────────────────
# 應用被入侵時，這些限制決定攻擊者能走多遠。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/yunzhi /var/log/yunzhi

LimitNOFILE=65536
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yunzhi-worker

[Install]
WantedBy=multi-user.target
