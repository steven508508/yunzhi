[Unit]
Description=雲端智學 — 主應用
Documentation=file:///opt/yunzhi/docs/OPERATIONS.md
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=yunzhi
Group=yunzhi
EnvironmentFile=/etc/default/yunzhi
EnvironmentFile=/etc/yunzhi/env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
WorkingDirectory=/opt/yunzhi
ExecStart=/usr/bin/node apps/web/.next/standalone/apps/web/server.js

Restart=always
RestartSec=5
# 啟動失敗連續 5 次就停止重試。無限重啟會把日誌塞滿，
# 掩蓋掉最初那一次真正有用的錯誤訊息。
StartLimitBurst=5
StartLimitIntervalSec=120

# 優雅關閉。60 秒讓手上的請求做完。
#
# 這裡以前寫的是「讓學生把本地暫存同步上來」——**前端沒有本機暫存**
# （沒有 IndexedDB、localStorage、sessionStorage），答案是每一題即時
# 送到伺服器的。所以寬限期救不回「還沒送出的那一題」，那一題本來就
# 只在畫面上。
#
# 那為什麼還是要 60 秒：SIGKILL 會切斷正在處理中的請求，也就是
# 「學生按下送出、伺服器還沒寫進資料庫」的那一瞬間。那才是真正
# 會掉資料的窗口，而它在交卷尖峰的每一秒都有人在裡面。
KillSignal=SIGTERM
TimeoutStopSec=60

# ── 沙箱化 ──────────────────────────────────────────────
# 應用被入侵時，這些限制決定攻擊者能走多遠。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/yunzhi /var/log/yunzhi

LimitNOFILE=65536
MemoryMax=1G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yunzhi-web

[Install]
WantedBy=multi-user.target
