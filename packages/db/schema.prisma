// 雲端智學 — 資料庫 Schema
//
// 本檔涵蓋「基礎層」：租戶、身分、權限、稽核、系統設定、AI 用量。
// 教學層（題庫、組卷、作答、評分、能力分析、錯題、作業）與營運層
// 的完整 schema 見規格書文件 02 與 10，依路線圖分階段加入。
//
// 三條貫穿全域的規則：
//   1. 所有租戶相關的表都帶 tenantId 並建複合索引。第一階段只有
//      單一租戶，成本幾乎為零，但省下的是日後啟用列級安全時的
//      大規模改表。
//   2. 任何涉及成績、題目、權限、金額的異動都寫 AuditLog，
//      且 AuditLog 只能新增不能修改。
//   3. 時間一律存 UTC，顯示層依 TZ 轉換。

generator client {
  provider = "prisma-client-js"
  // musl 目標是給 Docker 映像裡的 alpine 基底用的；native 給原生安裝。
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  // datasource 的 extensions 需要這個 preview flag，少了它
  // `prisma generate` 會在部署當下才失敗。
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm]
}

// ═══════════════════════════════════════════════════════════════
// 租戶與學年
// ═══════════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  name      String
  // 各科滿分、級分門檻、AI 配額、退費規則版本等機構層級設定
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  classes       Class[]
  auditLogs     AuditLog[]
  subjects      Subject[]

  examPapers  ExamPaper[]
  assignments Assignment[]
  @@map("tenants")
  tutorSessions     TutorSession[]
  abilitySnapshots  AbilitySnapshot[]
  admissionProfiles AdmissionProfile[]
  academicRanks     AcademicRank[]
  wishes            Wish[]
  admissionReferences AdmissionReference[]
  gradeProposals   AnswerGradeProposal[]
  gradeRecords     SubjectGradeRecord[]
  gradePredictions GradePrediction[]
  simulationRuns   SimulationRun[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  name      String // 「115學年度」
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes Class[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
  @@map("academic_years")
}

// ═══════════════════════════════════════════════════════════════
// 身分與權限
// ═══════════════════════════════════════════════════════════════

enum UserStatus {
  PENDING_CONSENT // 未成年，等待法定代理人同意
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SystemRole {
  STUDENT
  GUARDIAN
  TEACHER
  SUBJECT_LEAD // 學科召集人
  SCHOOL_ADMIN // 校務管理員
  SYS_ADMIN
  // 營運模組（M14 起）會新增 FRONT_DESK（行政人員／櫃檯）。
  // 它的職權與上述都不重疊：能收費、登出缺席、排課，
  // 但看不到成績與作答內容。規格未寫完之前先不加，
  // 因為新增角色會牽動整個權限矩陣與稽核設計。
}

enum ClassRole {
  STUDENT
  TEACHER
  ASSISTANT // 助教
  COUNSELOR // 升學輔導職權
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  username     String // 學號或教師代號
  email        String?
  displayName  String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  systemRole   SystemRole @default(STUDENT)

  // 未成年判定與家長同意（民法第 77、79 條；非個資法）
  birthDate     DateTime?
  guardianEmail String?
  consentAt     DateTime?

  // 無障礙設定。作答場次建立時會快照一份，
  // 事後改設定不影響已開始的考試。
  a11yProfile Json?

  // 登入安全
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  passwordChangedAt DateTime?
  mustChangePassword Boolean  @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships ClassMembership[]
  sessions    Session[]
  guardianOf  GuardianLink[]    @relation("Guardian")
  wardOf      GuardianLink[]    @relation("Student")
  auditLogs   AuditLog[]

  // 題庫層的反向關聯。全部是 SetNull —— 老師離職時題目與校對
  // 記錄要留著，只是不再指向一個已刪除的帳號。
  subjectTeaching     ClassSubjectTeacher[] @relation("SubjectTeaching")
  authoredQuestions   Question[]            @relation("QuestionAuthor")
  declaredImports     ImportJob[]           @relation("ImportRightsDeclarer")
  createdImports      ImportJob[]           @relation("ImportCreator")
  reviewedCandidates  ImportCandidate[]     @relation("CandidateReviewer")
  declaredExplanations Explanation[]        @relation("ExplanationDeclarer")
  resolvedDuplicates  DuplicateGroup[]      @relation("DuplicateResolver")
  verifiedSources     OfficialSourceFetch[] @relation("OfficialSourceVerifier")
  confirmedTypes      CustomQuestionType[]  @relation("CustomTypeConfirmer")

  createdPapers      ExamPaper[]        @relation("PaperCreator")
  createdAssignments Assignment[]       @relation("AssignmentCreator")
  assignedDirectly   AssignmentTarget[] @relation("AssignmentTargetUser")
  attempts           Attempt[]          @relation("AttemptUser")
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, systemRole])
  @@map("users")
  tutorSessions     TutorSession[]     @relation("TutorStudent")
  abilitySnapshots  AbilitySnapshot[]  @relation("AbilityUser")
  admissionProfile  AdmissionProfile[] @relation("AdmissionUser")
  academicRanks     AcademicRank[]     @relation("RankUser")
  wishes            Wish[]             @relation("WishUser")
  admissionReferences AdmissionReference[] @relation("ReferenceStudent")
  gradeRecords     SubjectGradeRecord[] @relation("GradeRecordUser")
  gradePredictions GradePrediction[]    @relation("PredictionUser")
  simulationRuns   SimulationRun[]      @relation("SimulationUser")
}

model GuardianLink {
  id         String    @id @default(cuid())
  guardianId String
  studentId  String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  guardian User @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  student  User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@index([studentId])
  @@map("guardian_links")
}

enum ClassType {
  HOMEROOM // 行政班
  GROUP // 教學群組
}

model Class {
  id             String    @id @default(cuid())
  tenantId       String
  academicYearId String
  name           String // 「三年甲班」或「數A加強班」
  type           ClassType @default(HOMEROOM)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  memberships     ClassMembership[]
  subjectTeachers ClassSubjectTeacher[]

  assignmentTargets AssignmentTarget[]
  @@unique([tenantId, academicYearId, name])
  @@index([tenantId, active])
  @@map("classes")
}

model ClassMembership {
  id       String    @id @default(cuid())
  classId  String
  userId   String
  role     ClassRole
  // 導師。跨科目，負責催繳與班務（訪談第 14 題的「催」）。
  isHomeroom Boolean @default(false)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId, role])
  @@index([userId, leftAt])
  @@map("class_memberships")
}

// ═══════════════════════════════════════════════════════════════
// Session（Auth.js 的資料庫 session）
//
// 用資料庫 session 而非純 JWT，理由是考試場景需要「立刻登出
// 某個帳號」這個能力 —— 發現代考時，JWT 要等到過期才失效。
// ═══════════════════════════════════════════════════════════════

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════
// 稽核
//
// 只新增不修改。資料庫層以觸發器強制（見 migration），
// 應用層沒有 update 與 delete 的路徑。
// 保存五年（規格書文件 01 §16）。
// ═══════════════════════════════════════════════════════════════

enum AuditCategory {
  AUTH // 登入、登出、密碼變更、帳號鎖定
  USER // 帳號與權限異動
  QUESTION // 題目建立、修訂、下架
  GRADE // 成績異動、重新計分
  EXAM // 任務派發、場次作廢
  BILLING // 繳費、退費試算（營運模組）
  SYSTEM // 設定變更、備份還原、升級
  SECURITY // 誠信事件、異常存取
}

model AuditLog {
  id        String        @id @default(cuid())
  tenantId  String
  category  AuditCategory
  action    String // 「user.password_reset」「grade.recalculate」
  actorId   String?
  actorIp   String?
  targetType String? // 「User」「Question」
  targetId  String?
  // 變更前後值。敏感欄位（密碼雜湊、金鑰）在寫入前遮蔽。
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, category, createdAt])
  @@index([tenantId, targetType, targetId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════
// 系統設定與版本
// ═══════════════════════════════════════════════════════════════

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("system_settings")
}

// 記錄每一次 schema 遷移與應用升級，供 rollback.sh 判斷
// 「回滾到上一版之後，資料庫要不要一起降版」。
model DeploymentRecord {
  id            String   @id @default(cuid())
  appVersion    String
  schemaVersion String
  action        String // install / upgrade / rollback
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  succeeded     Boolean?
  backupPath    String? // 升級前自動備份的位置
  notes         String?

  @@index([startedAt])
  @@map("deployment_records")
}

// ═══════════════════════════════════════════════════════════════
// AI 用量與成本
//
// 每一次模型呼叫都記一列。用途有三：成本歸因（哪個功能最貴）、
// 預算控管（超過月度上限時降級）、以及事後追溯（某題的解析
// 是哪個模型、哪個提示詞版本生成的）。
// ═══════════════════════════════════════════════════════════════

enum AiPurpose {
  IMPORT_EXTRACT // 題本結構化
  IMPORT_SOLVE // AI 自答
  IMPORT_ANNOTATE // 知識點標註
  IMPORT_REWRITE // 匯入解析的 AI 改寫
  GRADING // 非選題評分
  EXPLANATION // 解析生成
  TUTOR // 智慧老師
  ERROR_TAG // 錯因分類
  QUALITY_CHECK // 題目品質異常偵測
  EMBEDDING
  OTHER
}

enum AiTier {
  HIGH
  MID
  LIGHT
  EMBEDDING
}

model AiUsageLog {
  id           String    @id @default(cuid())
  tenantId     String
  purpose      AiPurpose
  tier         AiTier
  provider     String // anthropic / openai / mock
  model        String
  baseUrl      String? // 自訂閘道時記錄實際端點，供事後追溯
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  // 以設定的單價估算，僅供成本歸因參考，不是帳單。
  estimatedCost Decimal? @db.Decimal(12, 6)
  latencyMs    Int?
  succeeded    Boolean   @default(true)
  errorCode    String?
  retryCount   Int       @default(0)
  refType      String? // 「Question」「TutorSession」
  refId        String?
  promptVersion String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, purpose, createdAt])
  @@index([refType, refId])
  @@map("ai_usage_logs")
}

// 月度預算的即時累計。每次呼叫後 upsert，
// 避免每次都對 AiUsageLog 做全表 sum。
model AiBudgetCounter {
  id           String   @id @default(cuid())
  tenantId     String
  yearMonth    String // "2026-07"
  inputTokens  BigInt   @default(0)
  outputTokens BigInt   @default(0)
  callCount    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, yearMonth])
  @@map("ai_budget_counters")
}

// ═══════════════════════════════════════════════════════════════
// 通知（T0，六處功能的共同相依）
//
// 設計成單一匯流層而不是每個模組各接一次 LINE API。
// 沒有這一層，批次催繳、錯題到期、成績發布、家長週報、
// 到班離班通知會各自實作重試與免打擾，最後沒有一個地方
// 能回答「這位家長今天收到幾則通知」。
// ═══════════════════════════════════════════════════════════════

enum NotifyChannel {
  IN_APP
  EMAIL
  LINE
  SMS
}

enum NotifyStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SUPPRESSED // 免打擾時段或使用者偏好而未送出
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  key       String // 「assignment.due_soon」「attendance.checkin」
  channel   NotifyChannel
  subject   String?
  body      String // 支援 {{變數}} 插值
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key, channel])
  @@map("notification_templates")
}

model Notification {
  id          String        @id @default(cuid())
  tenantId    String
  recipientId String
  channel     NotifyChannel
  templateKey String
  payload     Json // 插值用的變數
  status      NotifyStatus  @default(QUEUED)
  scheduledAt DateTime      @default(now())
  sentAt      DateTime?
  readAt      DateTime?
  failReason  String?
  retryCount  Int           @default(0)
  // 去重鍵。同一個事件在重試或多次觸發時只送一次，
  // 避免家長在一分鐘內收到五則相同的到班通知。
  dedupeKey   String?
  createdAt   DateTime      @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([recipientId, status, scheduledAt])
  @@index([tenantId, status, scheduledAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  // 各 templateKey 的渠道開關
  channels  Json     @default("{}")
  // 免打擾時段，例如 {"start":"22:00","end":"07:00"}
  quietHours Json?
  lineUserId String? // LINE 綁定，櫃檯報名時掃碼完成
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// ═══════════════════════════════════════════════════════════════
// 題庫層
//
// 對應遷移 20260728000000_question_bank。遷移是手寫 SQL，這裡的
// 模型只是讓 Prisma Client 有型別可用 —— 兩者一旦不同步，
// 執行期會出現「欄位不存在」這種很難查的錯誤，所以任何一邊改了
// 都要同步另一邊，並跑 `prisma migrate diff` 確認沒有偏移。
//
// 幾個刻意的選擇：
//   · tenantId 大多是純欄位而非關聯 —— 遷移裡只有 subjects 對
//     tenants 建了外鍵，其餘表靠應用層與日後的列級安全把關。
//     這裡照實反映，不憑空補出資料庫沒有的外鍵。
//   · embedding 用 Unsupported。pgvector 的型別 Prisma 不認識，
//     檢索一律走 $queryRaw。
// ═══════════════════════════════════════════════════════════════

enum QuestionType {
  SINGLE_CHOICE // 單選題
  MULTI_CHOICE // 多選題，部分給分 (n-2k)/n
  FILL_SLOT // 選填題，答案填入答案卡編號格位
  FILL_TEXT
  SHORT_ANSWER
  ESSAY
  TRANSLATION
  TRUE_FALSE
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  RETIRED
}

enum SourceType {
  OFFICIAL_PAST // 歷屆試題，著作權法第 9 條不受保護
  TEACHER_ORIGINAL
  SCHOOL_EXAM
  PUBLISHER_SCAN
  AI_GENERATED
}

enum LicenseScope {
  PUBLIC
  TENANT_EXPORTABLE
  TENANT_NO_EXPORT
  INTERNAL_USE_ONLY
}

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum BloomLevelLegacy {
  KNOWLEDGE
  COMPREHENSION
  APPLICATION
  ANALYSIS
  SYNTHESIS
  EVALUATION
}

enum ImportStatus {
  QUEUED
  NORMALIZING
  SEGMENTING
  EXTRACTING
  SOLVING
  ANNOTATING
  DEDUPING
  READY_FOR_REVIEW
  COMMITTING
  COMMITTED
  FAILED
}

enum ImportFileRole {
  QUESTION_BOOK
  ANSWER_KEY
  EXPLANATION_BOOK
  RUBRIC
  UNKNOWN
}

enum CandidateState {
  PENDING
  CONFIRMED
  FLAGGED
  DISCARDED
}

enum TextbookNodeType {
  VOLUME
  THEME
  CHAPTER
  SECTION
  LESSON
}

enum ExplanationOrigin {
  AI_GENERATED
  TEACHER_WRITTEN
  OFFICIAL_CEEC
  AI_REWRITTEN
  VERBATIM_IMPORT
}

enum RightsBasis {
  OWNED
  LICENSED
  OFFICIAL_PUBLIC
  UNVERIFIED
}

enum ExplanationDisplay {
  FULL
  SUMMARY_ONLY
  HIDDEN
}

model Subject {
  id            String   @id @default(cuid())
  tenantId      String
  code          String // MATH_A / CHINESE / ENGLISH / SCIENCE / SOCIAL
  name          String
  // 學測滿分：社會 144、自然 128、其餘 100
  /// 分科所屬的學測合科代碼（CHEMISTRY → SCIENCE）。合科本身留空。
  ///
  /// 學測的自然與社會是合科考卷，但補習班是分科教的——化學老師傳
  /// 的是化學講義。少了這一欄，化學老師要組一份化學小考時，
  /// 他的題目跟生物的混在同一個題庫裡篩不出來。
  parentCode    String?
  gsatFullScore Int?
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  curriculumNodes CurriculumNode[]
  knowledgePoints KnowledgePoint[]
  questionGroups  QuestionGroup[]
  questions       Question[]
  importJobs      ImportJob[]
  editions        TextbookEdition[]
  classTeachers   ClassSubjectTeacher[]

  examPapers      ExamPaper[]
  @@unique([tenantId, code])
  @@map("subjects")
}

model CurriculumNode {
  id        String @id @default(cuid())
  tenantId  String
  subjectId String
  parentId  String?
  code      String // 108 課綱官方編碼，如 S-10-1
  title     String
  version   String @default("108")
  order     Int    @default(0)

  subject       Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent        CurriculumNode?          @relation("CurriculumTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      CurriculumNode[]         @relation("CurriculumTree")
  kpLinks       KpCurriculumLink[]
  textbookLinks TextbookCurriculumLink[]

  @@unique([subjectId, code, version])
  @@index([parentId, order])
  @@map("curriculum_nodes")
}

model KnowledgePoint {
  id          String   @id @default(cuid())
  tenantId    String
  subjectId   String
  name        String
  description String?
  // 遺忘衰減率。程序性知識衰減快，概念性較慢。
  decayRate   Float    @default(0.05)
  gsatWeight  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // pgvector。維度依 EMBEDDING_DIM，預設 bge-m3 的 1024。
  embedding Unsupported("vector(1024)")?

  subject         Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  curriculumLinks KpCurriculumLink[]
  questions       QuestionKnowledgePoint[]
  prerequisites   KpPrerequisite[]         @relation("KpSelf")
  requiredBy      KpPrerequisite[]         @relation("KpPrereq")

  @@unique([subjectId, name])
  @@index([tenantId, subjectId])
  @@map("knowledge_points")
  abilitySnapshots AbilitySnapshot[]
}

model KpCurriculumLink {
  knowledgePointId String
  curriculumNodeId String

  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)
  curriculumNode CurriculumNode @relation(fields: [curriculumNodeId], references: [id], onDelete: Cascade)

  @@id([knowledgePointId, curriculumNodeId])
  @@map("kp_curriculum_links")
}

// 前置關係 DAG。供智慧老師回溯與能力診斷。
model KpPrerequisite {
  kpId       String
  prereqKpId String
  strength   Float   @default(1.0)
  verifiedBy String?

  kp     KnowledgePoint @relation("KpSelf", fields: [kpId], references: [id], onDelete: Cascade)
  prereq KnowledgePoint @relation("KpPrereq", fields: [prereqKpId], references: [id], onDelete: Cascade)

  @@id([kpId, prereqKpId])
  @@map("kp_prerequisites")
}

model Publisher {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  editions  TextbookEdition[]
  questionTypes CustomQuestionType[]

  @@map("publishers")
}

/// 出版社專屬題型。
///
/// 出版社常有自己設計的題型：翰林的「觀念速記」、南一的「圖表解碼」、
/// 龍騰的某種雙欄配對。它們**呈現方式獨特，但作答方式幾乎一定是
/// 標準的那幾種之一**——這一點讓它變得可處理：系統不必懂那個題型的
/// 教學設計，只要知道學生怎麼答、怎麼給分。
///
/// 流程是「問老師一次，之後記住」：模型遇到不認得的題型時標成
/// OTHER 並保留原圖，校對介面拿給老師看並問三件事（這是什麼、
/// 學生怎麼作答、有沒有取得授權），老師確認後存成這一列；
/// 下一次同一種題型出現，定義會放進提示詞，模型就認得了。
///
/// **授權記在題型上而不是只記在匯入工作上。** 題型會被反覆使用，
/// 「這個題型我們有沒有權利用」是題型層級的事實，不是某一次匯入的。
model CustomQuestionType {
  id          String  @id @default(cuid())
  tenantId    String
  publisherId String?
  /// 出版社的名稱快照。出版社資料被整理過時，這個題型的來源仍然查得到。
  publisherName String?

  name        String  /// 「觀念速記」「圖表解碼」
  description String  /// 這個題型長什麼樣、要學生做什麼
  /// 學生實際上怎麼作答。對應 QuestionType，決定作答介面與評分邏輯。
  answerMode  QuestionType
  /// 給模型看的辨識線索：版面特徵、慣用標題、與哪些題型容易混淆。
  /// 這一段會被放進提示詞，所以寫得越具體，下一次認得越準。
  recognitionHint String?
  /// 一張範例圖，供校對者與日後的維護者對照。
  exampleAssetKey String?

  /// 授權基礎。與 ImportJob 用同一組值（OWNED／LICENSED／
  /// OFFICIAL_PUBLIC／UNVERIFIED）。UNVERIFIED 的題型可以辨識，
  /// 但它的題目不得散布到租戶之外。
  rightsBasis    String
  rightsNote     String?
  /// 誰確認的。這是責任歸屬——「向老師確認即可」的那個確認。
  confirmedBy    String?
  confirmedName  String?
  confirmedAt    DateTime?

  active    Boolean  @default(true)
  usageCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  publisher Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  confirmer User?      @relation("CustomTypeConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)

  /// 同一租戶下同一個出版社的題型名稱不重複。沒有這個約束的話，
  /// 每一次匯入都會建一個新的「觀念速記」，篩選就失效了。
  @@unique([tenantId, publisherName, name])
  @@index([tenantId, active])
  @@map("custom_question_types")
}

model TextbookEdition {
  id                String @id @default(cuid())
  tenantId          String
  publisherId       String
  subjectId         String
  curriculumVersion String @default("108")
  adoptedYears      Int[]  @default([])

  publisher Publisher      @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  nodes     TextbookNode[]

  @@unique([tenantId, publisherId, subjectId, curriculumVersion])
  @@map("textbook_editions")
}

model TextbookNode {
  id        String           @id @default(cuid())
  editionId String
  parentId  String?
  type      TextbookNodeType
  label     String
  order     Int              @default(0)

  edition         TextbookEdition          @relation(fields: [editionId], references: [id], onDelete: Cascade)
  parent          TextbookNode?            @relation("TextbookTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        TextbookNode[]           @relation("TextbookTree")
  curriculumLinks TextbookCurriculumLink[]
  questionLinks   QuestionTextbookLink[]

  @@index([editionId, parentId, order])
  @@map("textbook_nodes")
}

model TextbookCurriculumLink {
  textbookNodeId   String
  curriculumNodeId String
  coverage         Float  @default(1.0)

  textbookNode   TextbookNode   @relation(fields: [textbookNodeId], references: [id], onDelete: Cascade)
  curriculumNode CurriculumNode @relation(fields: [curriculumNodeId], references: [id], onDelete: Cascade)

  @@id([textbookNodeId, curriculumNodeId])
  @@map("textbook_curriculum_links")
}

// 題組：共用前導敘述。學測的混合題全部是這個結構。
model QuestionGroup {
  id             String   @id @default(cuid())
  tenantId       String
  subjectId      String
  stimulus       String // 前導敘述／閱讀素材
  stimulusAssets Json?
  label          String? // 「37-39 題為題組」
  // 同一次匯入的同一個 groupKey 只對應一個題組。
  // 沒有這個對應，重跑入庫會建出重複的題組。
  sourceImportJobId String?
  sourceGroupKey    String?
  createdAt      DateTime @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([sourceImportJobId, sourceGroupKey])
  @@index([tenantId, subjectId])
  @@map("question_groups")
}

model Question {
  id        String @id @default(cuid())
  tenantId  String
  subjectId String

  // 版本控制：familyId 跨版本穩定，id 是版本列的主鍵。
  // 作答記錄指向 id，因此天然版本化。
  familyId     String
  version      Int     @default(1)
  inheritStats Boolean @default(true)

  groupId  String?
  subLabel String? // 混合題子題：「（a）」「（b）」，全形

  type           QuestionType
  content        String // 題幹，內含 $LaTeX$
  contentAssets  Json?
  score          Float        @default(0)
  // 多選題的部分給分規則。存規則而非寫死，各科不同。
  scoringRule    Json?
  answerKeys     Int[]        @default([])
  answerSlots    Json?
  answerText     String?

  difficulty         Float?
  irtDifficulty      Float?
  irtDiscrimination  Float?
  irtGuessing        Float?
  responseCount      Int    @default(0)
  // 本班學生的答對率。由自己的作答記錄累積而來，會被重算。
  correctRate        Float?

  // 大考中心公布的**全國**答對率，講義上印成「答對率 43%」。
  // 與 correctRate 是兩回事，不可混用：那一個會被本班的作答重算，
  // 這一個是外部給定的常數，寫進去就不再改變。
  //
  // 這是題庫最值錢的一欄：一道考古題入庫當天就有校準過的難度，
  // 不必等本班學生作答幾百次；能力分析也才說得出「你錯的這題
  // 全國有 57% 的人也錯」，而不是只給一個分數。
  nationalCorrectRate Float?
  nationalSampleNote  String? // 出處與年份的補充，例如「大考中心 112 學測試題分析」

  bloomLevel       BloomLevel?
  bloomLevelLegacy BloomLevelLegacy?
  estTimeSeconds   Int?

  sourceType        SourceType
  sourceRef         String? // 「115學測數學A第12題」
  sourceExam        String? // 「112學測」——講義上印的出處標籤，供年份篩選
  licenseScope      LicenseScope
  sourceImportJobId String?

  status       QuestionStatus @default(DRAFT)
  qualityFlags Json?

  embedding Unsupported("vector(1024)")?

  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  retiredAt DateTime?

  subject         Subject                  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  group           QuestionGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  author          User?                    @relation("QuestionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  options         QuestionOption[]
  knowledgePoints QuestionKnowledgePoint[]
  textbookLinks   QuestionTextbookLink[]
  rubrics         Rubric[]
  explanations    Explanation[]
  duplicateOf     DuplicateMember[]
  fromCandidates  ImportCandidate[]        @relation("CandidateQuestion")
  dupCandidates   ImportCandidate[]        @relation("CandidateDuplicate")

  paperItems      ExamPaperItem[]
  attemptAnswers  AttemptAnswer[]
  @@unique([familyId, version])
  @@index([tenantId, subjectId, status])
  @@index([groupId])
  @@index([sourceType])
  @@index([sourceImportJobId])
  @@map("questions")
  tutorSessions TutorSession[]
  gradeProposals AnswerGradeProposal[]
}

// 選項獨立成表而非 JSON 陣列：選項數不固定（數學 5、英文 4），
// 且需要逐選項統計（哪個誘答項最多人選）。
model QuestionOption {
  id          String @id @default(cuid())
  questionId  String
  order       Int // 1..n，對應 (1)(2)(3)(4)(5)
  label       String
  content     String
  assets      Json?
  selectCount Int    @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, order])
  @@map("question_options")
}

model QuestionKnowledgePoint {
  questionId       String
  knowledgePointId String
  weight           Float   @default(1.0)
  confirmedBy      String?

  question       Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@id([questionId, knowledgePointId])
  @@map("question_knowledge_points")
}

model QuestionTextbookLink {
  questionId     String
  textbookNodeId String

  question     Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textbookNode TextbookNode @relation(fields: [textbookNodeId], references: [id], onDelete: Cascade)

  @@id([questionId, textbookNodeId])
  @@map("question_textbook_links")
}

// 評分量表。結構直接對應大考中心的評分原則：
//   國寫   → BAND      單一維度多等第（A+ 25–22、A 21–18…）
//   英作文 → DIMENSION 四維度各 5 分
//   中譯英 → DEDUCTION 扣分制
model Rubric {
  id         String   @id @default(cuid())
  tenantId   String
  questionId String?
  name       String
  totalScore Float
  mode       String   @default("BAND")
  // 評分原則的描述文字受著作權保護（文件 16 §3）。
  // 內部閱卷可呈現，不得散布或匯出給學生。
  sourceRef    String?
  internalOnly Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question   Question?          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  dimensions RubricDimension[]
  bands      RubricBand[]

  @@map("rubrics")
}

model RubricDimension {
  id         String  @id @default(cuid())
  rubricId   String
  name       String // 「內容」「組織」
  nameEn     String?
  maxScore   Float
  descriptor String?
  order      Int     @default(0)

  rubric Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  bands  RubricBand[]

  @@map("rubric_dimensions")
}

model RubricBand {
  id          String  @id @default(cuid())
  rubricId    String
  dimensionId String?
  grade       String // 'A+' 'A' 'B+' … '0'
  scoreMax    Float
  scoreMin    Float
  descriptor  String
  order       Int     @default(0)

  rubric    Rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  dimension RubricDimension? @relation(fields: [dimensionId], references: [id], onDelete: Cascade)

  @@index([rubricId, order])
  @@map("rubric_bands")
}

// ─────────────────────────────────────────────────────────────
// 匯入管線
// ─────────────────────────────────────────────────────────────

model ImportJob {
  id        String       @id @default(cuid())
  tenantId  String
  subjectId String
  title     String
  status    ImportStatus @default(QUEUED)

  sourceType   SourceType
  licenseScope LicenseScope
  // 權利聲明：誰聲明的、聲明了什麼。責任歸屬明確。
  //
  // rightsDeclaredName 是聲明人的姓名快照。帳號被刪時 rightsDeclaredBy
  // 會變成 NULL（ON DELETE SET NULL），但**誰聲明的這件事必須留著**
  // ——那是權利基礎的證據，也是 import_jobs_rights_declared 這個
  // CHECK 的另一半：少了它，刪掉任何一個曾聲明過權利的老師帳號
  // 都會撞上約束而失敗，而錯誤訊息完全看不出原因。
  rightsDeclaredBy   String?
  rightsDeclaredName String?
  rightsBasis        String?
  rightsNote         String?

  totalPages      Int?
  totalCandidates Int  @default(0)
  confirmedCount  Int  @default(0)
  flaggedCount    Int  @default(0)
  committedCount  Int  @default(0)
  commitDetail    Json?

  // 階段進度。埋在 stageDetail 的 JSONB 裡查起來太痛，
  // 而「卡在哪一階段、跑多久、花多少」是維運每天要看的。
  stageStartedAt     DateTime?
  lastCompletedStage String?
  attemptCount       Int       @default(0)
  aiCostTwd          Float     @default(0)

  // 校對節奏。驗收標準是 50 題 20 分鐘。
  reviewStartedAt DateTime?
  reviewSeconds   Int       @default(0)

  error       String?
  stageDetail Json?

  // 標準交換格式（QIF）的完整文件。
  //
  // 這是**模型理解這份原稿之後的標準化結果**——不論原稿是哪一科、
  // 哪一家出版社、教用版還是學生版、原生 PDF 還是手機拍的，這一欄
  // 的形狀都一樣。候選題是從它產出來的，而它本身留著，因為：
  //
  //   · 校對介面要顯示題組的共用素材、圖的替代文字、觀念頁——
  //     那些東西不屬於任何單一候選題，沒地方掛
  //   · 抽取邏輯改版後要能重跑而不必再付一次模型的錢
  //   · 老師問「這一題原稿到底寫什麼」時，這是唯一的答案
  //
  // documentSchema 記版本。格式一定會長，而題庫裡會同時存在好幾個
  // 版本產出的資料——沒有版本號的話，日後任何一次調整都要靠猜。
  documentJson   Json?
  documentSchema String?

  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  committedAt DateTime?

  subject    Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  declarer   User?             @relation("ImportRightsDeclarer", fields: [rightsDeclaredBy], references: [id], onDelete: SetNull)
  creator    User?             @relation("ImportCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  files      ImportFile[]
  pages      ImportPage[]
  candidates ImportCandidate[]

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("import_jobs")
}

model ImportFile {
  id         String         @id @default(cuid())
  jobId      String
  role       ImportFileRole @default(UNKNOWN)
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  storageKey String
  pageCount  Int?
  // 掃描件與照片的品質評估，決定要提示老師逐題確認的程度
  qualityScore Float?
  qualityNote  String?
  // 內容指紋。同一份講義被兩位老師各傳一次時認得出來 ——
  // 省下的不只是儲存空間，是第二次的 AI 費用與第二次的校對工時。
  sha256       String?
  uploadedAt   DateTime @default(now())

  job   ImportJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pages ImportPage[]

  @@index([jobId])
  @@index([sha256])
  @@map("import_files")
}

/// 正規化後的頁面。第 1 階段產出，後續各階段與校對介面共用。
model ImportPage {
  id         String @id @default(cuid())
  jobId      String
  fileId     String
  index      Int // 該檔案內的頁碼，從 1 起算
  width      Int
  height     Int
  storageKey String
  // 原生 PDF 才有。比 OCR 準得多，但版面資訊要靠座標推斷。
  textLayer    String?
  quality      Float    @default(1.0)
  qualityNotes Json     @default("[]")
  // 版面切割結果（第 2 階段）。每頁一份，避免整份文件一大坨。
  blocks       Json?
  // 這一頁偵測到的圖。關聯到哪一題是切分階段算的，
  // 原始清單留在頁面上，重跑結構化時不必重新裁圖。
  figures      Json?
  createdAt    DateTime @default(now())

  job  ImportJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file ImportFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, index])
  @@index([jobId])
  @@index([jobId, quality])
  @@map("import_pages")
}

// 匯入候選題：校對介面操作的對象。確認後才寫入 questions。
model ImportCandidate {
  id         String  @id @default(cuid())
  jobId      String
  order      Int
  questionNo String? // 原稿上的題號，可能是「37-39」
  subLabel   String?
  groupKey   String? // 同一題組的候選共用此鍵

  type        QuestionType?
  content     String?
  stimulus    String?
  options     Json? // [{order,label,content}]
  answerKeys  Int[]         @default([])
  answerSlots Json?
  answerText  String?
  score       Float?

  // 信心與扣分理由。校對者靠這個決定「要不要細看」，
  // 是 20 分鐘校完 50 題的關鍵。
  confidence        Float @default(0)
  confidenceReasons Json  @default("[]")

  // 答案來源：題本附的、獨立答案卷對齊的、或 AI 自答
  answerOrigin    String?
  selfConsistency Float?
  solveTrace      Json?

  kpSuggestions Json?
  sourceBbox    Json? // 原稿座標，供左右連動
  sourcePage    Int?
  // 這一題的附圖。[{key, bbox, labels, width, height}]
  // 幾何題沒有圖就是不能用的題目，所以它與題幹一樣重要。
  assets        Json?

  // 原稿附帶的內容。與 answerText 分開存：answerText 是校對後
  // 要入庫的值，這幾個是原稿長什麼樣，不一致時要看得出來。
  explanationRaw  String? // 教用版的詳解。著作權地位與試題不同，分開判斷
  sourceAnswerRaw String? // 原稿印出的答案
  label           String? // 講義的題目標頭（「範例 3」「類題 1」）

  // 原稿印在題目旁的出處與全國答對率（「112學測」「答對率 43%」）。
  // 只在原稿真的印了才有值——推估出來的難度不可以存進這裡。
  sourceExam          String?
  nationalCorrectRate Float?

  // 出版社專屬題型。模型認出既有定義時填 id；提議新題型時只有
  // 名稱，等老師確認後才會建出定義並回填 id。
  customTypeId   String?
  customTypeName String?

  state      CandidateState @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?
  questionId String?

  duplicateOfId  String?
  duplicateScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job         ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewer    User?     @relation("CandidateReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  question    Question? @relation("CandidateQuestion", fields: [questionId], references: [id], onDelete: SetNull)
  duplicateOf Question? @relation("CandidateDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)

  @@unique([jobId, order])
  @@index([jobId, state])
  @@index([jobId, confidence])
  @@map("import_candidates")
}

model Explanation {
  id           String             @id @default(cuid())
  tenantId     String
  questionId   String
  origin       ExplanationOrigin
  rightsBasis  RightsBasis
  licenseScope LicenseScope
  displayMode  ExplanationDisplay @default(FULL)
  isPrimary    Boolean            @default(false)

  // 分層結構：結論、步驟、誘答項剖析、延伸
  layers Json @default("{}")
  // 匯入的原文。不直接呈現給學生，僅作為 AI 改寫的依據。
  rawBody      String?
  groundedOnId String?

  sourceRef     String?
  declaredBy    String?
  modelUsed     String?
  promptVersion String?
  takedownAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  declarer   User?         @relation("ExplanationDeclarer", fields: [declaredBy], references: [id], onDelete: SetNull)
  groundedOn Explanation?  @relation("ExplanationGrounding", fields: [groundedOnId], references: [id], onDelete: SetNull)
  rewrites   Explanation[] @relation("ExplanationGrounding")

  @@index([questionId])
  @@map("explanations")
}

model DuplicateGroup {
  id         String    @id @default(cuid())
  tenantId   String
  subjectId  String
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  resolver User?             @relation("DuplicateResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  members  DuplicateMember[]

  @@map("duplicate_groups")
}

model DuplicateMember {
  groupId    String
  questionId String
  similarity Float
  isKeeper   Boolean @default(false)

  group    DuplicateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([groupId, questionId])
  @@map("duplicate_members")
}

// 科目老師：這個人教這個班的這一科。
// 訪談第 14 題：派任與批改是「科目或班級老師」，催繳是「班級老師」，
// 而「有時候班級老師就是那一科的老師」—— 兩種職權必須分得開。
model ClassSubjectTeacher {
  id         String   @id @default(cuid())
  classId    String
  subjectId  String
  userId     String
  // 主授或協同。一科三位老師（訪談第 1 題）需要區分。
  isPrimary  Boolean  @default(true)
  assignedAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user    User    @relation("SubjectTeaching", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId, userId])
  @@index([userId])
  @@map("class_subject_teachers")
}

// 官方資料的年度取得記錄（文件 16）
model OfficialSourceFetch {
  id           String  @id @default(cuid())
  sourceUrl    String
  docType      String // PAPER / ANSWER_KEY / RUBRIC
  academicYear Int
  subjectCode  String?
  sha256       String

  fetchedAt DateTime @default(now())
  // 驗證結果。順序見文件 16 §4：
  // 機械不變量 → 跨文件交叉 → 跨年度比對 → 獨立重抽比對 → 人工
  checksPassed Json     @default("[]")
  checksFailed Json     @default("[]")
  verifiedBy   String?
  verifiedAt   DateTime?

  verifier User? @relation("OfficialSourceVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@unique([sourceUrl, sha256])
  @@map("official_source_fetches")
}

// ═══════════════════════════════════════════════════════════════════
// 考卷、任務、作答、成績
//
// 這四組是「從題庫到成績」那條線的骨架，也是這個 schema 原本完全
// 沒有的部分——42 張表全部停在題庫，於是老師建好題目之後就沒有下一步了。
//
// 設計上有三個地方是刻意的，因為它們各自對應一種會安靜出錯的狀況：
//
// 一、**作答的快照與題庫分離。** Attempt 產生時把題目的順序、選項順序、
//    配分全部固定下來。老師在考試進行中改了題目（改錯字、補選項），
//    已經開始作答的學生看到的必須是他開始時的那一份，否則他會在
//    第 12 題重新整理之後看到不一樣的選項，而他的答案是照舊的編號存的。
//
// 二、**時間以伺服器為準。** expiresAt 在開始作答時就算好寫死，
//    交卷時比對的是它而不是前端送來的時間。前端的計時器只是顯示。
//    這一條不做的話，改系統時間就能無限延長考試。
//
// 三、**答案與計分分開存。** answerKeys 是學生選了什麼，earnedScore 是
//    它值幾分。重新計分（老師改了標準答案、或送分）時只動後者，
//    學生原本選了什麼永遠不變——那是申訴時唯一能拿出來的東西。
// ═══════════════════════════════════════════════════════════════════

enum PaperStatus {
  DRAFT
  READY // 可以派了
  ARCHIVED
}

enum AssignmentMode {
  EXAM // 正式測驗：計時、不可回頭改、成績計入
  PRACTICE // 練習：不計時、可重做、即時看解析
}

/// 解析什麼時候給學生看。四段的差別在不同情境下差很多。
enum ReleasePolicy {
  IMMEDIATE // 每題作答後
  ON_SUBMIT // 全部交卷後
  ON_DUE // 截止日後（全班同時，避免先寫的洩題）
  MANUAL // 老師手動放行
  NEVER
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  VOIDED // 作廢（誠信事件、系統故障）
}

model ExamPaper {
  id        String      @id @default(cuid())
  tenantId  String
  subjectId String
  title     String
  status    PaperStatus @default(DRAFT)
  /// 配分總和。由題目加總算出來後存下來，避免每次列表都要 join。
  totalScore Float      @default(0)
  /// 說明文字，會印在作答畫面最上方（「請以 2B 鉛筆…」這類）
  instructions String?
  createdBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  creator     User?            @relation("PaperCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items       ExamPaperItem[]
  assignments Assignment[]

  @@index([tenantId, subjectId, status])
  @@map("exam_papers")
}

model ExamPaperItem {
  id         String @id @default(cuid())
  paperId    String
  questionId String
  order      Int
  /// 這一份卷子上這一題值幾分。可以與題庫的預設配分不同——
  /// 同一題在小考與模考的配分本來就會不一樣。
  score      Float

  paper    ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([paperId, questionId])
  @@unique([paperId, order])
  @@index([questionId])
  @@map("exam_paper_items")
}

model Assignment {
  id       String         @id @default(cuid())
  tenantId String
  paperId  String
  title    String
  mode     AssignmentMode @default(EXAM)

  openAt  DateTime?
  dueAt   DateTime?
  /// 作答時限（分鐘）。null 代表不限時。
  timeLimitMin Int?
  /// 截止後還可以交嗎。遲交會標記但不擋。
  allowLate    Boolean @default(false)
  /// 每人最多幾次。練習模式常設成多次。
  maxAttempts  Int     @default(1)

  /// 題序與選項順序隨機。防作弊的第一層，而且不需要學生裝任何東西。
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)

  releasePolicy ReleasePolicy @default(ON_DUE)
  /// 手動放行的時間戳。releasePolicy=MANUAL 時看它。
  releasedAt    DateTime?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paper   ExamPaper          @relation(fields: [paperId], references: [id], onDelete: Restrict)
  creator User?              @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  targets AssignmentTarget[]
  attempts Attempt[]

  @@index([tenantId, openAt, dueAt])
  @@map("assignments")
}

/// 派給誰。班級或個人，兩者可以並存（整班加上補考的兩位）。
model AssignmentTarget {
  id           String  @id @default(cuid())
  assignmentId String
  classId      String?
  userId       String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  class      Class?     @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User?      @relation("AssignmentTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, classId, userId])
  @@index([classId])
  @@index([userId])
  @@map("assignment_targets")
}

model Attempt {
  id           String        @id @default(cuid())
  assignmentId String
  userId       String
  attemptNo    Int           @default(1)
  status       AttemptStatus @default(IN_PROGRESS)

  startedAt   DateTime  @default(now())
  /// **伺服器算出來的到期時間，開始作答時就寫死。**
  /// 交卷時比對的是它，不是前端送來的時間——否則改系統時間就能
  /// 無限延長考試。前端的倒數只是顯示。
  expiresAt   DateTime?
  submittedAt DateTime?
  /// 時間到自動交卷（不是學生自己按的）
  autoSubmitted Boolean @default(false)
  /// 逾期交卷。allowLate 為 true 時才可能出現。
  late          Boolean @default(false)

  /// **題目與選項的順序快照。** 隨機出題時每個人不同，而重新整理
  /// 之後必須看到同一份；老師在考試中改了題目也不能影響已開始的人。
  /// 形狀：[{ questionId, order, score, optionOrder: [1,3,2,...] }]
  layout Json?

  /// 客觀題自動計分的結果。非選題等人工或 AI 評分後再補。
  autoScore  Float?
  totalScore Float?
  gradedAt   DateTime?

  assignment Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User            @relation("AttemptUser", fields: [userId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@unique([assignmentId, userId, attemptNo])
  @@index([userId, status])
  @@index([assignmentId, status])
  @@map("attempts")
  tutorSessions TutorSession[]
  proctorEvents ProctorEvent[]
  gradeProposals AnswerGradeProposal[]
}

model AttemptAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  /// 學生選了什麼。**重新計分時不動這裡。**
  answerKeys  Int[]   @default([])
  answerText  String?
  answerSlots Json?
  /// 標記待複查。作答介面的「先跳過」。
  flagged     Boolean @default(false)

  /// 計分結果。老師改了標準答案或送分時只動這幾欄。
  isCorrect   Boolean?
  earnedScore Float?
  /// 為什麼是這個分數。多選部分給分要說得出「答錯 1 個，得 3/5」。
  scoreNote   String?

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("attempt_answers")
}

// ═══════════════════════════════════════════════════════════════
// 智慧老師、能力分析、考試行為偵測、家長端、升學輔導
//
// 這一批的共同點是**它們都建立在既有資料之上**：作答記錄早就逐題
// 存著 isCorrect，知識點與題目的關聯在匯入時就標好了，家長與學生的
// 連結表從第一版就在 schema 裡。缺的一直是「把它們接起來的那一層」。
//
// 四個貫穿的決定：
//
// **一、能力分析用快照，不是每次即時算。**
// 200 位學生 × 每學期約 40 份任務 × 25 題 = 20 萬列作答。每次打開
// 頁面都 join `attempt_answers` 與 `question_knowledge_points` 再
// 分組，是一個會隨學期線性變慢的設計——而它變慢的時間點正好是
// 資料開始有意義的時候。所以計分完成時順手更新快照。
//
// **二、智慧老師的對話要留下來，而且要能被老師看到。**
// 這是未成年人與 AI 的對話，發生在補習班的系統裡。不留紀錄的話，
// 出事時沒有人說得出發生過什麼；而只留給學生自己看，等於補習班對
// 自己場域內的 AI 互動沒有任何監督能力。留存期限與可見範圍寫在
// TutorSession 的欄位註解裡。
//
// **三、考試行為只記錄，不中斷。**
// 切換分頁與離開全螢幕會被記下來給老師看，但**系統不會自動判定
// 作弊、不會自動交卷、不會鎖住畫面**。理由在 ProctorEvent 的註解。
//
// **四、升學輔導的管道狀態用兩個正交欄位，不用單一列舉。**
// 這是規格書文件 06 第 5.2 節點名的坑：學生放棄繁星之後，如果狀態
// 塌縮成「已放棄」，系統就再也分不出他原本是第 1-7 類（永久封鎖
// 個人申請）還是第 8 類（可報名但不可登記志願序）。見 AdmissionProfile。
// ═══════════════════════════════════════════════════════════════

// ── 智慧老師 ────────────────────────────────────────────────

enum TutorRole {
  STUDENT
  TUTOR
  /// 系統插入的脈絡（題目、學生的作答、正確答案）。不顯示在對話裡。
  CONTEXT
}

enum TutorStatus {
  OPEN
  /// 學生說他懂了，或關掉了。
  CLOSED
  /// 觸發了安全規則而停止（見 TutorMessage.blocked）。
  HALTED
}

/// 一次針對某一題的引導式教學對話。
///
/// **綁在 attempt + question 上，不是綁在學生身上。** 同一位學生對
/// 同一題在不同次考試後的對話是分開的兩段——他第二次問的時候，
/// 上一次的理解程度已經不同了，把兩段接在一起會讓 AI 以為他還停在
/// 三個月前的位置。
model TutorSession {
  id           String      @id @default(cuid())
  tenantId     String
  userId       String
  attemptId    String?
  questionId   String
  status       TutorStatus @default(OPEN)

  /// 學生自陳的卡點，開場時問的第一件事。引導的起點。
  stuckAt      String?
  /// 這一段對話涵蓋了哪些知識點。用於能力分析的「問過但仍不會」。
  kpIds        String[]    @default([])

  /// 學生按「我懂了」。沒有按不代表沒懂，所以不拿它當成效指標的分母。
  resolvedAt   DateTime?
  messageCount Int         @default(0)
  tokensIn     Int         @default(0)
  tokensOut    Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User           @relation("TutorStudent", fields: [userId], references: [id], onDelete: Cascade)
  attempt  Attempt?       @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([tenantId, userId, createdAt])
  @@index([questionId])
  @@map("tutor_sessions")
}

model TutorMessage {
  id        String    @id @default(cuid())
  sessionId String
  role      TutorRole
  content   String

  /// 被安全規則擋下來的訊息仍然存，但不送給學生。
  /// 刪掉的話，事後沒有人查得出「他問了什麼才觸發的」。
  blocked       Boolean @default(false)
  blockedReason String?

  modelUsed     String?
  promptVersion String?
  latencyMs     Int?

  createdAt DateTime @default(now())

  session TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("tutor_messages")
}

// ── 能力分析 ────────────────────────────────────────────────

/// 一位學生在一個知識點上的掌握度快照。計分完成時更新。
///
/// **`mastery` 不是答對率。** 答對率把三個月前的一題與昨天的一題
/// 算成一樣重，而遺忘是真的——`KnowledgePoint.decayRate` 存在就是
/// 為了這件事。掌握度是時間加權的，公式與理由寫在 lib/ability 那一層。
///
/// 保留 `correct`／`total` 原始計數，因為老師會問「這個 0.35 是怎麼
/// 算出來的」，而一個算不出來的數字沒有人會相信。
model AbilitySnapshot {
  id               String @id @default(cuid())
  tenantId         String
  userId           String
  knowledgePointId String

  correct Int   @default(0)
  total   Int   @default(0)
  /// 0 到 1。時間加權，越近期的作答權重越高。
  mastery Float @default(0)
  /// 樣本太少時掌握度不可靠。低於門檻時介面要說「資料不足」而不是
  /// 顯示一個看起來精確的小數。
  reliable Boolean @default(false)

  lastAnsweredAt DateTime?
  /// 連續答錯幾次。用於「這個知識點卡住了」的主動提示。
  streakWrong    Int       @default(0)

  updatedAt DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User           @relation("AbilityUser", fields: [userId], references: [id], onDelete: Cascade)
  knowledgePoint KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgePointId])
  @@index([tenantId, knowledgePointId])
  @@map("ability_snapshots")
}

// ── 考試行為偵測 ────────────────────────────────────────────

enum ProctorEventType {
  /// 分頁被切走（visibilitychange）
  TAB_HIDDEN
  /// 切回來
  TAB_VISIBLE
  /// 視窗失去焦點（blur）——切到別的應用程式，或開了另一個視窗
  WINDOW_BLUR
  WINDOW_FOCUS
  /// 離開全螢幕
  FULLSCREEN_EXIT
  FULLSCREEN_ENTER
  /// 貼上。大段貼上多半是從別處抄來的。
  PASTE
  /// 作答畫面在背景超過門檻時間之後才回來
  LONG_ABSENCE
}

/// 考試期間的行為事件。
///
/// # 為什麼只記錄不中斷
///
/// 業主原本要的是驅動程式等級的監考 Client。那條路我們沒有走
/// （文件 04 的理由），改成瀏覽器層的偵測——而瀏覽器層的偵測**一定
/// 會有偽陽性**：手機來電、系統通知、輸入法切換、螢幕旋轉，都會產生
/// blur。自動判定作弊並中斷考試，代價是一個沒有作弊的學生在考試中
/// 被踢出去，而那件事無法補救。
///
/// 所以這裡的定位是**給老師看的證據**，不是自動裁判。老師看到「這位
/// 學生在 60 分鐘裡切走 14 次、其中一次 4 分鐘」時，他有足夠的資訊
/// 決定要不要處理；系統不替他決定。
///
/// 學生端在考試開始前會被明確告知這件事會被記錄——不告知而偷偷記錄
/// 是另一個問題。
model ProctorEvent {
  id        String           @id @default(cuid())
  attemptId String
  type      ProctorEventType
  at        DateTime         @default(now())

  /// 這一段離開持續了多久（毫秒）。TAB_VISIBLE／WINDOW_FOCUS 才有值。
  durationMs Int?
  /// 當下在第幾題。老師要判斷「他是在難題上離開的嗎」。
  questionOrder Int?
  /// 貼上的字元數等。刻意不存貼上的內容——那可能是學生自己打的草稿。
  meta Json?

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, at])
  @@map("proctor_events")
}

// ── 升學輔導（第一階段：制度規則與繁星校內賽局）──────────────

enum AdmissionChannel {
  SPECIAL   // 特殊選才
  STAR      // 繁星推薦
  APPLY     // 個人申請
  PLACEMENT // 分發入學
}

/// 繁星的錄取類別。**一經錄取即固定，放棄不清空。**
///
/// 這是文件 06 第 5.2 節點名的坑。用單一列舉（未錄取／已錄取／已放棄）
/// 的話，學生放棄之後系統就分不出他原本是哪一類——而第 1-7 類是
/// 永久封鎖個人申請（放棄也沒用），第 8 類只封鎖登記志願序。
/// 兩者的輔導建議完全相反，而搞錯的代價是學生錯過一整個管道。
enum StarCategory {
  NONE
  GROUP_1_7
  GROUP_8
}

/// 一位學生在某學年度的升學狀態。
///
/// 管道狀態刻意用「錄取」與「已放棄」兩個正交的布林值，見 StarCategory
/// 的註解。判定邏輯在 lib/admission 那一層，有完整笛卡兒積的測試。
model AdmissionProfile {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  /// 民國學年度，例如 115。
  year     Int

  /// 非應屆。影響繁星資格。
  isRepeater    Boolean @default(false)
  /// 全程就讀同一高中未轉學。繁星資格。
  sameSchoolAll Boolean @default(true)

  specialAdmitted Boolean      @default(false)
  specialWaived   Boolean      @default(false)
  starCategory    StarCategory @default(NONE)
  starWaived      Boolean      @default(false)
  applyAdmitted   Boolean      @default(false)
  applyWaived     Boolean      @default(false)

  /// 實際學測成績（公布後填入）。形狀 { CHINESE: 13, MATH_A: 12, ... }
  gsatScores Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("AdmissionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([tenantId, year])
  @@map("admission_profiles")
}

/// 五學期在校成績的全校排名百分比。**本模組最敏感的一張表。**
///
/// 越小越好（1% 是全校第一）。由教務處匯入，**不進入任何學生可查詢
/// 的 API**——學生端只拿得到「自己在某個志願上的校內序位」這一個
/// 整數，而且參與人數少於 3 人時連序位都不給（否則排第 2 的人可以
/// 反推出排第 1 的是誰）。
model AcademicRank {
  id         String @id @default(cuid())
  tenantId   String
  userId     String
  year       Int
  percentile Float
  /// 採計學期數。繁星是 5。
  semesters  Int    @default(5)

  importedBy String
  importedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("RankUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([tenantId, year])
  @@map("academic_ranks")
}

/// 一個志願。繁星的校內賽局模擬吃的就是這張表。
model Wish {
  id       String           @id @default(cuid())
  tenantId String
  userId   String
  year     Int
  channel  AdmissionChannel
  rank     Int

  /// 大學名稱。第一階段不建完整的校系資料庫（歷年篩選資料禁止爬取，
  /// 見文件 07），所以這裡先收自由輸入的文字，之後接得上正式的
  /// Program 表時再遷移。
  institutionName String
  programName     String?
  /// 繁星學群 1-8。
  starGroup       Int?

  /// 學生自述的興趣理由。用於偵測「志願完全依錄取機率排、與興趣脫節」。
  interestTag String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("WishUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, channel, rank])
  @@index([tenantId, year, channel])
  @@map("wishes")
}

// ── 學生自己查來的升學參考資料 ──────────────────────────────

/// 這一筆資料是怎麼來的。**決定它值多少信任,以及能不能餵給模擬。**
enum SourceKind {
  /// 官方文件：簡章 PDF、委員會的查詢頁、大考中心的統計表
  OFFICIAL_DOC
  /// 學校教務處提供（校內百分比、校內推薦辦法）
  SCHOOL_OFFICE
  /// 補習班老師提供
  CRAM_TEACHER
  /// 學生自己從別處抄來、或記憶所及
  STUDENT_NOTE
  /// 聽同學說的、網路論壇、坊間工具
  HEARSAY
}

/// 學生（或輔導老師）自己查來並輸入的升學參考資料。
///
/// # 為什麼要有這張表,而不是直接建一個校系資料庫
///
/// 規格書文件 06 與 07 查證的結論是:招聯會全站 robots.txt 禁止爬取、
/// 個申二階錄取分數沒有全國統一表、ColleGo! 沒有 API。所以「系統自動
/// 取得全國校系資料」這條路走不得。
///
/// 但**禁止的是機器,不是人**。學生自己打開官方網頁查一個校系的錄取
/// 標準完全沒有問題,而且那本來就是輔導老師會叫他做的事。所以系統的
/// 角色從「幫你查」變成三件它真的做得到的事:**告訴你去哪裡查**、
/// **把你查到的東西記下來（含來源與日期）**、**在上面給建議**。
///
/// # 三個貫穿的決定
///
/// **一、來源與查詢日期是必填,不是選填。** 一個沒有來源的數字在三個
/// 月後與一個有來源的長得一模一樣,而學生會照著它決定要不要填志願。
/// `sourceKind` 與 `lookedUpAt` 因此是 NOT NULL。
///
/// **二、學生自己輸入的在校百分比不進入校內賽局模擬。**
/// 模擬會影響**其他學生**看到的位置——甲同學把自己的百分比打錯成 5%,
/// 乙同學看到的序位就跟著錯,而乙完全不知道。所以模擬只吃教務處匯入
/// 的 `AcademicRank`;學生自己輸入的只用於他自己的建議。
/// 這一條寫在 `forSelfOnly` 的註解裡,而且有測試。
///
/// **三、`staleAfterYear` 讓資料自己過期。** 學年度換了,去年的錄取標準
/// 仍然有參考價值（規格書說歷年趨勢是唯一可用的東西）,但它必須被標成
/// 「這是 115 學年度的資料,你現在看的是 116」。不標的話,一份三年前
/// 的數字會被當成今年的門檻。
model AdmissionReference {
  id       String @id @default(cuid())
  tenantId String
  /// 誰輸入的。學生自己,或輔導老師代為輸入。
  enteredBy String
  /// 這筆資料是關於誰的。自己查校系資料時等於 enteredBy;
  /// 輔導老師幫某位學生記錄時是那位學生。
  userId    String

  /// 這筆資料屬於哪一個學年度（民國）。
  year    Int
  channel AdmissionChannel

  /// 大學名稱。與 Wish 一樣先收自由輸入的文字。
  institutionName String
  programName     String?
  starGroup       Int?

  /// 查到的是什麼。`kind` 決定 `value` 的形狀,兩者一起解讀。
  /// STAR_ROUND1 → { percentile: 15.2 }（最後一名錄取者的在校百分比）
  /// STAR_ROUND2 → 同上
  /// STAR_VACANCY → { count: 3 }
  /// SIEVE_THRESHOLD → { subjects: [...], grades: [...] }
  /// QUALIFY → { rules: "數A均標、英文前標" }
  /// MY_PERCENTILE → { percentile: 12.4 }（自己的校內百分比）
  /// NOTE → { text: "..." }（沒有結構的補充,例如校內推薦辦法的重點）
  kind  String
  value Json

  /// 來源。必填,理由見檔頭決定一。
  sourceKind SourceKind
  /// 從哪裡查到的。官方文件填網址或文件名稱;教務處填「教務處 X 老師」。
  sourceRef  String
  /// 查到的日期。必填。
  lookedUpAt DateTime

  /// 超過這個學年度之後這筆資料要被標成過期。預設等於 year。
  staleAfterYear Int

  /// **只用於這位學生自己的建議,不進入任何跨學生的計算。**
  /// 學生自己輸入的一律為 true;輔導老師輸入的校系資料可以是 false。
  /// 理由見檔頭決定二——打錯的數字會讓別人看到錯的序位而不自知。
  forSelfOnly Boolean @default(true)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student User   @relation("ReferenceStudent", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, year, channel])
  @@index([userId, year])
  @@map("admission_references")
}

// ═══════════════════════════════════════════════════════════════
// 非選題的 AI 閱卷、級分預測、個申落點
//
// 這三塊的共同前提是**它們都已經不缺資料了**：
//
//   · 評分規準（Rubric／RubricDimension／RubricBand）從第一版就在
//     schema 裡，只是從來沒有人寫進去
//   · 級分預測原本卡在「需要 IRT 能力估計」——但補習班的模擬考本來
//     就會announce級分，那是直接觀測值，比從作答反推可靠得多
//   · 個申落點原本卡在「歷年篩選標準禁止爬取」——而
//     `AdmissionReference` 已經收得下學生自己查來的門檻
//
// 三個貫穿的決定：
//
// **一、AI 的評分是提案，不是分數。**
// 這是專案第一條原則（AI 提出、人類決定）在這裡最硬的一次應用。
// AI 的輸出寫進 `AnswerGradeProposal`，**永遠不會自己變成
// `AttemptAnswer.earnedScore`**——中間一定要有一個老師按下去的動作。
// 理由見那張表的註解。
//
// **二、預測一律是區間加信心，而且要追蹤自己的準確度。**
// 「你的數學 A 預估 12 級分」會被學生當成承諾。`GradePrediction`
// 保存每一次預測，等實際成績出來後回填 `actualGrade`——**一個不追蹤
// 自己準確度的預測系統只是在製造好看的數字**。
//
// **三、每一次模擬都要能重現。**
// 學生會問「上週看到的是 60%，現在怎麼變 45%」。`SimulationRun`
// 保存輸入快照，才回答得出是資料更新了還是他的成績變了。
// ═══════════════════════════════════════════════════════════════

// ── 非選題的 AI 閱卷 ────────────────────────────────────────

enum ProposalState {
  /// AI 給了建議，還沒有人看
  PENDING
  /// 老師照 AI 的建議給分
  ACCEPTED
  /// 老師改了分數才給
  ADJUSTED
  /// 老師不採用，自己給分
  REJECTED
  /// 安全規則擋下來了（見 blockedReason）
  BLOCKED
}

/// AI 對一題非選答案的評分**建議**。
///
/// # 為什麼它與分數是兩張表
///
/// 因為它們是兩件事，而把它們放在一起的那一版一定會有人「順手」讓
/// AI 的分數直接生效——那是這個系統裡最不能發生的事。作文的分數會
/// 影響學生的成績單，而 AI 對中文作文的評分**沒有任何可稽核的
/// 基準**；老師改過的分數才是分數。
///
/// 所以 `AttemptAnswer.earnedScore` 只有兩個寫入者：客觀題的自動
/// 計分，與老師手動輸入。這張表**沒有任何路徑**寫得到它。
///
/// # 為什麼要保存被否決的建議
///
/// 因為那是唯一看得出「AI 的閱卷準不準」的資料。老師採用率 90% 與
/// 30% 是兩個完全不同的世界，而後者代表這個功能該關掉。刪掉被否決
/// 的建議，就永遠算不出這個數字。
model AnswerGradeProposal {
  id       String @id @default(cuid())
  tenantId String
  /// 對哪一份作答的哪一題。不用 attemptAnswerId：學生可能整題空白
  /// 而沒有那一列，而空白也是要給 0 分的。
  attemptId  String
  questionId String

  state ProposalState @default(PENDING)

  /// AI 建議的總分。
  suggestedScore Float
  /// 逐面向的分數。形狀 [{ dimensionId, name, score, max, reason }]
  /// 沒有 rubric 時是空陣列——那時 `suggestedScore` 的可信度低得多，
  /// 而畫面上要說出來。
  dimensions Json @default("[]")
  /// 給老師看的理由。**不直接給學生**——它可能引用 rubric 的描述文字，
  /// 而 `Rubric.internalOnly` 預設為真（授權範圍是內部閱卷）。
  rationale  String
  /// 模型自陳的信心。低信心的要排在老師的待閱清單前面。
  confidence Float?

  /// 被安全規則擋下的建議仍然存，理由必填。
  blockedReason String?

  modelUsed     String?
  promptVersion String?
  rubricId      String?

  /// 老師最後給了幾分。與 `suggestedScore` 的差距就是這個功能的誤差。
  finalScore   Float?
  decidedBy    String?
  decidedAt    DateTime?
  /// 老師為什麼改。ADJUSTED／REJECTED 時要求填——那是改進提示詞的唯一素材。
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([tenantId, state, createdAt])
  @@map("answer_grade_proposals")
}

// ── 級分預測 ────────────────────────────────────────────────

/// 一位學生在一次考試中某一科的級分。
///
/// # 為什麼要有這張表，而不是從作答記錄反推
///
/// 級分預測原本被記成「需要 IRT 能力估計，核心系統沒有」。那個判斷
/// 錯在它忽略了一件現成的事：**補習班的模擬考本來就會公布級分**
/// （南模、全模、校內模考），而那是直接觀測值。
///
/// 從我們自己的作答記錄反推級分要跨兩道換算（原始分→難度校正→級距），
/// 每一道都會放大誤差，而級距在校內人數不足時本身就不可靠（文件 A.2）。
/// 直接收學生手上那張成績單上的數字，誤差是零。
///
/// `source` 分辨這個級分是哪裡來的——系統自己算的（本系統的模考）
/// 與外部模考公布的，可信度不同，而混在一起算趨勢會讓人以為兩者
/// 一樣準。
model SubjectGradeRecord {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  /// 科目代碼，與 `Subject.code` 一致（MATH_A、CHINESE…）。
  subjectCode String
  /// 這次考試的名稱。「115 全模一」「校內第二次模考」
  examName    String
  /// 考試日期。趨勢與時間加權都靠它。
  examDate    DateTime
  /// 級分 0 到 15。
  grade       Int
  /// 全國或全校的百分位（如果成績單有給）。
  percentile  Float?

  /// EXTERNAL_MOCK（外部模考）／INTERNAL_MOCK（本系統的模考）／
  /// OFFICIAL_GSAT（真正的學測，公布後填）
  source     String
  /// 誰輸入的。學生自己，或老師代為輸入。
  enteredBy  String

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("GradeRecordUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectCode, examName])
  @@index([tenantId, userId, examDate])
  @@map("subject_grade_records")
}

/// 一次級分預測的快照。**存在的理由是校準,不是顯示。**
///
/// 規格書第 6.2 節：「預測系統若不追蹤自己的準確度,就只是在製造好看
/// 的數字。」所以每一次預測都存下來,等實際學測成績出來後回填
/// `actualGrade`,然後算校準曲線——所有被預測為「信心 70%」的區間裡,
/// 實際落在區間內的比例是否接近 70%。
///
/// 偏離就代表模型過度自信或過度保守。這份資料按年度累積,是機構真正
/// 的資產:用了三屆之後這套預測會明顯比第一屆準,**而且準確度是可以
/// 被證明的**。
model GradePrediction {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  subjectCode String
  /// 預測的是哪一個學年度的學測（民國）。
  targetYear  Int

  /// 區間下界與上界（級分）。**介面上不存在呈現單一數字的路徑。**
  intervalLow  Int
  intervalHigh Int
  /// 信心水準 0 到 1。0.7 代表「七成的機會落在這個區間裡」。
  confidence   Float

  /// 完整的機率分布。[{ grade: 12, p: 0.28 }, ...]
  /// 下游的落點模擬**直接用這個分布而非點估計**——用點估計算落點會
  /// 嚴重低估風險（規格書第 6.1 節）。
  distribution Json

  /// 這個預測建立在什麼上面。樣本數、用了哪幾次考試、剩餘時間。
  /// 資料不足時要說得出來,而不是硬給一個區間。
  basis Json
  /// 樣本數低於門檻。介面上要標「資料不足,預測不可靠」。
  thin  Boolean @default(false)

  /// 實際成績（學測公布後回填,3 月）。校準曲線靠它。
  actualGrade Int?

  predictedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("PredictionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, targetYear, subjectCode])
  @@index([userId, predictedAt])
  @@map("grade_predictions")
}

// ── 個申落點模擬 ────────────────────────────────────────────

/// 一次落點模擬。**保存輸入快照,理由是可重現。**
///
/// 學生會問「上週看到的是 60%,現在怎麼變 45%」。沒有快照的話,
/// 沒有人回答得出是資料更新了、他的成績變了、還是程式改了。
model SimulationRun {
  id       String @id @default(cuid())
  tenantId String
  userId   String

  channel AdmissionChannel
  year    Int

  /// 輸入快照:當時的級分分布、當時採用的門檻資料（含每一筆的來源
  /// 與可靠度）、當時的志願清單。
  input  Json
  /// 逐志願的結果。含每一個數字的資料基礎與可靠度標示。
  result Json

  /// 所用資料的最舊更新日期。畫面上要顯示——一份三年前的資料算出來
  /// 的機率,與上週更新過的,不是同一種東西。
  dataAsOf DateTime
  /// 抽樣次數。
  draws    Int      @default(10000)

  runAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("SimulationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, runAt])
  @@map("simulation_runs")
}
