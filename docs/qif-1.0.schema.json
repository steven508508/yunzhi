{
  "$defs": {
    "Answer": {
      "description": "一題的答案。**只記原稿印了什麼。**\n\n五個欄位互斥使用，由題型決定該用哪一個——分成五欄而不是一個\n自由字串，是因為下游要拿它自動改考卷。改考卷的邏輯不該去猜\n「(B)」跟「B」跟「2」是不是同一件事。",
      "properties": {
        "source": {
          "$ref": "#/$defs/AnswerSource",
          "default": "NONE"
        },
        "keys": {
          "items": {
            "type": "integer"
          },
          "title": "Keys",
          "type": "array"
        },
        "slots": {
          "items": {
            "$ref": "#/$defs/AnswerSlot"
          },
          "title": "Slots",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "grid": {
          "items": {
            "$ref": "#/$defs/GridCell"
          },
          "title": "Grid",
          "type": "array"
        }
      },
      "title": "Answer",
      "type": "object"
    },
    "AnswerSlot": {
      "description": "學測選填題的答案格位。答案卡上的格子有編號（⑬⑭）。",
      "properties": {
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "slot",
        "value"
      ],
      "title": "AnswerSlot",
      "type": "object"
    },
    "AnswerSource": {
      "description": "**只有兩種。** 系統推導的答案不進這個格式——那是自答階段的\n產物，帶著投票次數與一致率，存在候選題上。\n\n混在一起之後，半年後沒有人分得出「這個答案是題本印的還是\n系統猜的」，而那兩者的可信度差了一個量級。",
      "enum": [
        "PRINTED",
        "NONE"
      ],
      "title": "AnswerSource",
      "type": "string"
    },
    "Asset": {
      "description": "圖、表、音檔、影音連結。**全文件唯一 id**，內容用 `![[a:id]]` 參照。\n\n表格也算資產而不是直接寫進題幹：表格常常被兩題共用（地理那份\n「西班牙流感死亡人數」表就是），而且它需要獨立的替代文字。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "alt": {
          "default": "",
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "table_markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Markdown"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "storage_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Key"
        }
      },
      "required": [
        "id",
        "kind",
        "placement"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "FIGURE",
        "TABLE",
        "AUDIO",
        "VIDEO_LINK",
        "QR",
        "OTHER"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "BBox": {
      "description": "原稿座標，供校對介面左右連動。單位為頁面寬高的比例（0–1）。",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "x0": {
          "maximum": 1,
          "minimum": 0,
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "maximum": 1,
          "minimum": 0,
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "page",
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Confidence": {
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ConfidenceReason"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "score"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceReason": {
      "description": "扣分理由。**必須具體到校對者知道要看哪裡。**\n\n不合格：「辨識信心較低」\n合格：  「選項 (3) 的指數字跡黏連，未能確定是 6 或 8」",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "minLength": 4,
          "title": "Detail",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "warn"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "ConfidenceReason",
      "type": "object"
    },
    "CustomTypeRef": {
      "description": "出版社專屬的題型。\n\n出版社常有自己設計的題型：翰林的「觀念速記」、南一的「圖表解碼」、\n龍騰的某種雙欄配對。它們**呈現方式獨特，但作答方式幾乎一定是\n標準的那幾種之一**——這一點讓它變得可處理：系統不必懂那個題型\n的教學設計，只要知道學生要怎麼答、怎麼給分。\n\n流程是「問老師一次，之後記住」：\n\n  1. 模型遇到不認得的題型 → `kind=OTHER` ＋ 一筆 unsupported_content\n  2. 校對介面把裁下來的原圖與模型的猜測拿給老師看，問這是什麼、\n     學生要怎麼答、有沒有取得出版社授權\n  3. 老師確認後存成租戶層級的題型定義\n  4. 下一次同一種題型出現，定義會放進提示詞，模型就認得了，\n     `kind` 填 PUBLISHER_CUSTOM 並帶上 `custom_type`\n\n**授權要記在這裡而不是只記在匯入工作上。** 題型會被反覆使用，\n而「這個題型我們有沒有權利用」是題型層級的事實，不是某一次\n匯入的事實。",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "answer_mode": {
          "$ref": "#/$defs/QuestionKind",
          "default": "SHORT_ANSWER"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "CustomTypeRef",
      "type": "object"
    },
    "DocumentMeta": {
      "properties": {
        "subject": {
          "$ref": "#/$defs/SubjectCode",
          "default": "UNKNOWN"
        },
        "genre": {
          "$ref": "#/$defs/Genre",
          "default": "UNKNOWN"
        },
        "edition": {
          "$ref": "#/$defs/Edition",
          "default": "UNKNOWN"
        },
        "language": {
          "default": "unknown",
