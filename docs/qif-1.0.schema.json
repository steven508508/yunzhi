            "zh-Hant",
            "en",
            "mixed",
            "unknown"
          ],
          "title": "Language",
          "type": "string"
        },
        "textbook": {
          "$ref": "#/$defs/TextbookRef"
        },
        "page_count": {
          "default": 0,
          "minimum": 0,
          "title": "Page Count",
          "type": "integer"
        },
        "source_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source File"
        }
      },
      "title": "DocumentMeta",
      "type": "object"
    },
    "DocumentStats": {
      "description": "校對介面第一眼要看的數字。由組裝階段算出來，不是模型填的。",
      "properties": {
        "questions": {
          "default": 0,
          "title": "Questions",
          "type": "integer"
        },
        "with_printed_answer": {
          "default": 0,
          "title": "With Printed Answer",
          "type": "integer"
        },
        "with_explanation": {
          "default": 0,
          "title": "With Explanation",
          "type": "integer"
        },
        "with_assets": {
          "default": 0,
          "title": "With Assets",
          "type": "integer"
        },
        "groups": {
          "default": 0,
          "title": "Groups",
          "type": "integer"
        },
        "materials": {
          "default": 0,
          "title": "Materials",
          "type": "integer"
        },
        "unsupported": {
          "default": 0,
          "title": "Unsupported",
          "type": "integer"
        },
        "mean_confidence": {
          "default": 0.0,
          "title": "Mean Confidence",
          "type": "number"
        }
      },
      "title": "DocumentStats",
      "type": "object"
    },
    "Edition": {
      "description": "教用版印答案與詳解，學生版不印。這個差別決定了整份的價值。",
      "enum": [
        "TEACHER",
        "STUDENT",
        "UNKNOWN"
      ],
      "title": "Edition",
      "type": "string"
    },
    "Explanation": {
      "description": "原稿的詳解。**與題幹分開存。**\n\n試題依著作權法第 9 條不受保護，詳解受保護。把它寫進題幹等於\n把一份受保護的內容標成不受保護。",
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "stated_answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stated Answer"
        }
      },
      "required": [
        "body"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "Genre": {
      "description": "原稿的體例。決定下游怎麼切、怎麼呈現。",
      "enum": [
        "EXAM",
        "WORKSHEET",
        "MATERIAL",
        "ANSWER_KEY",
        "SOLUTION",
        "MIXED",
        "UNKNOWN"
      ],
      "title": "Genre",
      "type": "string"
    },
    "GridCell": {
      "description": "社會科非選的作答格：第 row 列勾第 col 欄。",
      "properties": {
        "row": {
          "title": "Row",
          "type": "string"
        },
        "col": {
          "title": "Col",
          "type": "string"
        }
      },
      "required": [
        "row",
        "col"
      ],
      "title": "GridCell",
      "type": "object"
    },
    "Group": {
      "description": "題組。共用的素材放在這裡，子題只放自己的部分。\n\n這是原本的格式最大的缺口：學測有大量題組（閱讀測驗、克漏字、\n圖表題、實驗題），把共用敘述複製到每一題裡的話，重複題偵測會\n把整組看成互相重複，而學生在第二題看到的是同一段又讀一次。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GroupKind",
          "default": "MIXED"
        },
        "lead": {
          "default": "",
          "title": "Lead",
          "type": "string"
        },
        "stimulus": {
          "default": "",
          "title": "Stimulus",
          "type": "string"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Id"
        }
      },
      "required": [
        "id",
        "placement"
      ],
      "title": "Group",
      "type": "object"
    },
    "GroupKind": {
      "description": "題組共用的是什麼。",
      "enum": [
        "PASSAGE",
        "CLOZE",
        "DATA",
        "EXPERIMENT",
        "SCENARIO",
        "MIXED"
      ],
      "title": "GroupKind",
      "type": "string"
    },
    "Issue": {
      "description": "這份原稿裡有問題、或格式吃不下的東西。\n\n`raw` 是這整個設計的安全閥：**對不上任何型別的內容不允許塞進\n任何一個型別**，而是原樣留在這裡。硬塞的代價不是資料難看，\n是沒有人會發現——一張五線譜被當成表格塞進題幹，出來的是一串\n亂碼；一個獨有題型被當成單選題，選項是空的而答案指向不存在的\n選項。兩者都會安靜地進到題庫。",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "warn"
        },
        "detail": {
          "minLength": 4,
          "title": "Detail",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Id"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw"
        },
        "raw_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Asset Id"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Material": {
      "description": "講義的觀念頁：文法表格、公式整理、例句對照、「使用時機」說明。\n\n不是題目，但也不是垃圾——智慧老師要在學生卡住時「退回去補前置\n觀念」，而那些內容就是教材。同一份 PDF 裡本來就有。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
