        "custom_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomTypeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "stem",
        "placement",
        "confidence"
      ],
      "title": "Question",
      "type": "object"
    },
    "QuestionKind": {
      "description": "題型。**這一組要涵蓋五科**，所以比資料庫既有的列舉多幾項。\n\n加的那幾項都是實際看得到的：社會科的作答格（MATCHING）、\n國文的排序題（ORDERING）、數學的計算證明（CALCULATION）、\n英聽（LISTENING）。OTHER 是逃生口，用它的時候一定要附 issue。",
      "enum": [
        "SINGLE_CHOICE",
        "MULTI_CHOICE",
        "TRUE_FALSE",
        "FILL_SLOT",
        "FILL_BLANK",
        "MATCHING",
        "ORDERING",
        "SHORT_ANSWER",
        "CALCULATION",
        "ESSAY",
        "TRANSLATION",
        "LISTENING",
        "PUBLISHER_CUSTOM",
        "OTHER"
      ],
      "title": "QuestionKind",
      "type": "string"
    },
    "Scoring": {
      "description": "配分與給分規則。",
      "properties": {
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "partial_credit": {
          "default": false,
          "title": "Partial Credit",
          "type": "boolean"
        },
        "word_limit": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Limit"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "sig_figs": {
          "anyOf": [
            {
              "maximum": 15,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sig Figs"
        },
        "rubric_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubric Raw"
        }
      },
      "title": "Scoring",
      "type": "object"
    },
    "Section": {
      "description": "節。試卷是「一、單選題（占 30 分）」，講義是「考古題大搜查」\n「綜合演練」。兩者形狀完全不同，但作用一樣：交代這一段的體例。",
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "default_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "default_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Score"
        },
        "total_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Score"
        }
      },
      "required": [
        "id",
        "title",
        "placement"
      ],
      "title": "Section",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SubjectCode": {
      "description": "科目。\n\n**學測的「自然」與「社會」是合科考卷，但補習班是分科教的。**\n化學老師傳的是化學講義、地理老師傳的是地理講義；訪談時說的\n「每科三位老師、七個班」指的就是分科。只留 SCIENCE 一個值的話，\n化學老師的題目會跟生物的混在同一個題庫裡，而他要組一份化學\n小考時篩不出來。\n\n所以分科與合科並存：SCIENCE／SOCIAL 給學測合科試卷用，\n其餘給日常的分科講義用。",
      "enum": [
        "CHINESE",
        "ENGLISH",
        "MATH_A",
        "MATH_B",
        "SOCIAL",
        "SCIENCE",
        "HISTORY",
        "GEOGRAPHY",
        "CIVICS",
        "PHYSICS",
        "CHEMISTRY",
        "BIOLOGY",
        "EARTH_SCIENCE",
        "ELECTIVE",
        "UNKNOWN"
      ],
      "title": "SubjectCode",
      "type": "string"
    },
    "TextbookRef": {
      "description": "教科書索引：出版社 × 冊次 × 章節。\n\n這是台灣老師實際使用的第一層索引（文件 11），而它**就印在每一頁\n的頁首**——「4-1 直線方程式及其圖形」「單元 1 地理技能」\n「13 代名詞」。不收下來的話，日後要靠人一本一本補。",
      "properties": {
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "book": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Book"
        },
        "volume": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Volume"
        },
        "chapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "title": "TextbookRef",
      "type": "object"
    }
  },
  "description": "一份原稿被理解之後的標準形狀。**這是存進系統的東西。**\n\n下游只認這個形狀，永遠不必知道原稿是哪一家出版社、哪一科、\n教用版還是學生版、原生 PDF 還是手機拍的。",
