          "default": null,
          "title": "Section Id"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "topic_hints": {
          "items": {
            "type": "string"
          },
          "title": "Topic Hints",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "body",
        "placement"
      ],
      "title": "Material",
      "type": "object"
    },
