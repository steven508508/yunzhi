####################################################################
# 雲端智學 — 環境設定範本
#
# 用法：cp .env.example .env && ./deploy/scripts/gen-secrets.sh
# 標示 [必填] 者沒有安全的預設值，安裝腳本會拒絕啟動。
# 標示 [自動] 者由 gen-secrets.sh 產生，不要手填。
#
# 這個檔案會被讀進 Docker Compose 與原生安裝兩條路徑，
# 是全系統唯一的設定來源。改完務必執行：
#   ./deploy/scripts/doctor.sh --config-only
####################################################################

# ─────────────────────────────────────────────────────────────────
# 1. 部署識別
# ─────────────────────────────────────────────────────────────────

# 對外主機名。Caddy 用它申請憑證。
# 內網部署（沒有公開網域）請填內網 IP 或 .local 名稱，並把
# TLS_MODE 設為 internal，Caddy 會簽發本地 CA 憑證。
# [必填]
APP_DOMAIN=yunzhi.example.edu.tw

# 對外網址，含協定。寄信、通知、OAuth 回呼都用它。
APP_URL=https://yunzhi.example.edu.tw

# 部署環境：production / staging
NODE_ENV=production

# 機構名稱，顯示在登入頁與通知中
TENANT_NAME=雲端智學

# 時區。台灣一律 Asia/Taipei；排程、截止時間、報表全依此。
TZ=Asia/Taipei

# ─────────────────────────────────────────────────────────────────
# 2. 反向代理與 TLS
# ─────────────────────────────────────────────────────────────────

# caddy    : 由本系統內建的 Caddy 處理 TLS 與對外流量，佔用 80／443。
#            適合這台機器只跑雲端智學的情況。
# external : 機器上已有 nginx／Apache／其他代理。本系統**不碰 80／443**，
#            只把應用綁在 WEB_BIND 指定的位址，由既有代理轉發進來。
#            TLS 由那個代理處理，下方的 TLS_MODE 與 ACME_EMAIL 會被忽略。
#
# 設為 external 之後，執行 sudo ./deploy/scripts/setup-nginx.sh
# 會產生對應的 nginx 站台設定並驗證。
PROXY_MODE=caddy

# PROXY_MODE=external 時，應用綁定的位址。
# **一定要綁 127.0.0.1 而不是 0.0.0.0** —— 綁 0.0.0.0 等於把未經
# TLS、未經速率限制的應用直接暴露在網路上，繞過你的 nginx 全部防護。
WEB_BIND=127.0.0.1
WEB_BIND_PORT=3000

# 以下 TLS 設定只在 PROXY_MODE=caddy 時有作用。

# letsencrypt : 公開網域，自動申請與續期（需 80/443 對外可達）
# internal    : 內網部署，Caddy 簽發本地 CA；根憑證在
#               deploy/scripts/export-ca.sh 匯出後由 MIS 派送
# custom      : 自備憑證，放在 deploy/caddy/certs/{fullchain.pem,privkey.pem}
TLS_MODE=internal

# letsencrypt 模式必填，憑證到期通知寄到這裡
ACME_EMAIL=

# ─────────────────────────────────────────────────────────────────
# 3. 資料庫
# ─────────────────────────────────────────────────────────────────

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=yunzhi
POSTGRES_USER=yunzhi
# [自動]
POSTGRES_PASSWORD=

# 連線池上限。單機 300 人同時作答的基準值。
# 調高之前先確認 PostgreSQL 的 max_connections 夠（見 deploy/postgres/postgresql.conf）。
DATABASE_POOL_MAX=20

# WAL 歸檔。開啟後 RPO 可壓到 15 分鐘以內（規格書文件 01 §16 的要求）。
# 關閉則只剩每日快照，RPO 退化為 24 小時 —— 正式環境不要關。
WAL_ARCHIVE_ENABLED=true
# 歸檔保留天數。磁碟吃緊時才調低，低於 7 天會讓時間點還原失去意義。
WAL_ARCHIVE_RETENTION_DAYS=14

# ─────────────────────────────────────────────────────────────────
# 4. Redis
# ─────────────────────────────────────────────────────────────────

REDIS_HOST=redis
REDIS_PORT=6379
# [自動]
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────
# 5. 物件儲存（題本原檔、圖片、掃描答卷）
# ─────────────────────────────────────────────────────────────────

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=yunzhi
S3_ACCESS_KEY=yunzhi
# [自動]
S3_SECRET_KEY=
# MinIO 用 path-style；換成 AWS S3 要改 false
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────────
# 6. 認證
# ─────────────────────────────────────────────────────────────────

# [自動] Auth.js 的 session 加密金鑰。換掉會讓所有人被登出。
AUTH_SECRET=

# Session 有效期（秒）。預設 12 小時，涵蓋一個完整的補習班營業日。
AUTH_SESSION_MAX_AGE=43200

# 初始管理員。只在第一次 migrate 時建立，之後改這裡沒有作用。
# 密碼留空則由 install.sh 產生一組隨機密碼並印在畫面上（只印一次）。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu.tw
BOOTSTRAP_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────
# 7. AI 服務
#
# 支援兩種 API 協定，都可以指定自訂 Base URL —— 這是為了讓你
# 能接 Anthropic 官方、OpenAI 官方、或任何相容的閘道／代理／
# 自架推論服務（vLLM、Ollama、LiteLLM、one-api 等）。
#
# 切換 provider 不需要改任何程式碼，AI 服務啟動時讀這幾個變數
# 決定要走哪一條路徑。
# ─────────────────────────────────────────────────────────────────

# anthropic        : Anthropic Messages API 協定
# openai           : OpenAI Chat Completions 協定（含所有相容閘道）
# mock             : 不呼叫任何外部服務，回傳結構正確的假資料。
#                    用於安裝驗證、CI、以及還沒有 key 的時候 ——
#                    整套流程可以完整跑通，只是內容是假的。
AI_PROVIDER=mock

# Base URL。留空則使用該 provider 的官方端點：
#   anthropic → https://api.anthropic.com
#   openai    → https://api.openai.com/v1
# 自訂範例：
#   AI_BASE_URL=https://your-gateway.example.com/v1
#   AI_BASE_URL=http://vllm:8000/v1
AI_BASE_URL=

# [必填，除非 AI_PROVIDER=mock]
AI_API_KEY=

# 模型分級路由（規格書文件 03 §1.1）。
# 三級的用途分別是：
#   HIGH  — AI 自答、數學與作文評分、智慧老師的診斷決策（錯誤代價最高）
#   MID   — 題目結構化、解析生成、簡答評分、引導對話
#   LIGHT — 知識點重排序、錯因分類、題型判定、格式正規化
# 名稱直接傳給上游，接自訂閘道時填閘道認得的名稱即可。
AI_MODEL_HIGH=claude-opus-4-20250514
AI_MODEL_MID=claude-sonnet-4-20250514
AI_MODEL_LIGHT=claude-haiku-4-20250514

# 嵌入模型。與生成模型分開選型（規格書文件 02 §1.2）——
# Anthropic 協定沒有嵌入端點，所以這一項一定要獨立設定。
# local  : 在 AI 容器內跑 sentence-transformers（預設，資料不出校內）
# openai : 走 OpenAI 協定的嵌入端點
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# EMBEDDING_PROVIDER=openai 時才需要；留空則沿用 AI_BASE_URL / AI_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# 併發與重試
AI_MAX_CONCURRENCY=4
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=3

# 每月 token 預算上限。超過時 AI 功能降級為不可用，但**考試、
# 客觀題評分、已生成的解析全部照常運作**（規格書文件 01 §16）。
# 設為 0 表示不限制。
AI_MONTHLY_TOKEN_BUDGET=0

# 單價表。用於估算每份題本的 AI 成本，顯示在匯入進度頁上。
# 以新台幣計、每百萬 token；鍵是上游實際回報的模型名稱
# （不是 AI_MODEL_* 的值——經過閘道時兩者可能不同，
#  看一次匯入的用量記錄就知道該填什麼）。
#
# 留空的話成本一律記為 0，其餘功能不受影響。刻意不預設任何數字：
# 一個過期的價目表比沒有價目表更容易誤導人。
#
# AI_PRICING={"claude-opus-4-20250514":{"in":480,"out":2400},"claude-sonnet-4-20250514":{"in":96,"out":480}}
AI_PRICING=

# ─────────────────────────────────────────────────────────────────
# 7b. 題本匯入
# ─────────────────────────────────────────────────────────────────

# 同時處理幾份題本。
#
# 預設 1 不是保守，是刻意：匯入是這台機器上最吃資源的工作
# （PDF 渲染、影像處理、大量並行的 AI 呼叫），而同一台機器還要
# 服務正在考試的學生。兩份題本同時解析會讓考試端的回應時間
# 明顯變差——而考試不能等，題本可以。
#
# 要更快的正確做法是加一台專跑 worker 的機器，不是調大這個數字。
IMPORT_CONCURRENCY=1

# ─────────────────────────────────────────────────────────────────
# 8. 備份
# ─────────────────────────────────────────────────────────────────

BACKUP_DIR=/var/backups/yunzhi
BACKUP_RETENTION_DAYS=30
# 每日備份時間（cron 格式，本機時區）
BACKUP_SCHEDULE="15 3 * * *"

# 備份加密。強烈建議開啟 —— 備份檔含全體學生個資，
# 而備份通常會被複製到隨身碟或 NAS 這些管控較鬆的地方。
# [自動]
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_ENABLED=true

# 異地備份（選配）。留空則只保留本機備份。
# 支援任何 S3 相容端點。
BACKUP_REMOTE_ENDPOINT=
BACKUP_REMOTE_BUCKET=
BACKUP_REMOTE_ACCESS_KEY=
BACKUP_REMOTE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────
# 9. 監控與告警
# ─────────────────────────────────────────────────────────────────

# 啟用 Prometheus + Grafana + Loki（docker compose --profile monitoring）
MONITORING_ENABLED=false
GRAFANA_ADMIN_USER=admin
# [自動]
GRAFANA_ADMIN_PASSWORD=

# 告警通知。留空則只在 Grafana 介面顯示。
ALERT_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────
# 10. 資源上限
#
# 預設值以「4 核 8GB、300 人同時作答」為基準。
# 調整前先看 docs/OPERATIONS.md 的容量規劃一節。
# ─────────────────────────────────────────────────────────────────

WEB_REPLICAS=2
WEB_MEMORY_LIMIT=1g
WORKER_REPLICAS=1
WORKER_MEMORY_LIMIT=1g
# AI 服務吃記憶體（本地嵌入模型約 2GB），不要調太低
AI_MEMORY_LIMIT=4g
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_MAX_CONNECTIONS=200

# ─────────────────────────────────────────────────────────────────
# 11. 日誌
# ─────────────────────────────────────────────────────────────────

LOG_LEVEL=info
LOG_FORMAT=json
# 單一容器的日誌上限，避免磁碟被寫滿導致考試中斷
LOG_MAX_SIZE=100m
LOG_MAX_FILE=5
